<?xml version="1.0" encoding="utf-8"?>
<!-- The description of the Microsoft Store package (MSIX). build_desktop.py fills
     in the names starting with a dollar sign: the identity from store_identity.json, the version from
     version.py. Microsoft signs the package when the Store accepts it. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
         IgnorableNamespaces="uap rescap desktop6">
  <Identity Name="$name" Publisher="$publisher" Version="$version" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>$display_name</DisplayName>
    <PublisherDisplayName>$publisher_display_name</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Your data stays in the same folder as the other installer's
         (AppData\Local\Job Finder) and survives uninstalling, instead of
         Windows moving it to a folder of the package's own. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources><Resource Language="en-us" /></Resources>
  <Applications>
    <Application Id="JobFinder" Executable="Job Finder.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="$display_name" Description="Find Israeli tech jobs that fit your CV"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <!-- An ordinary desktop program (it starts Claude Code, keeps keys in the
         password safe, serves its page on this PC). -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Needed for the data folder setting above. -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
